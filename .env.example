JBM_ENV=development
JBM_HTTP_ADDR=:8080
JBM_HTTP_READ_HEADER_TIMEOUT=5s
JBM_HTTP_READ_TIMEOUT=10s
JBM_HTTP_WRITE_TIMEOUT=15s
JBM_HTTP_IDLE_TIMEOUT=60s
JBM_HTTP_SHUTDOWN_TIMEOUT=10s

JBM_DATABASE_URL=postgres://postgres:postgres@localhost:5432/justbarme?sslmode=disable
JBM_DB_MAX_CONNS=10
JBM_DB_MIN_CONNS=1
JBM_DB_MAX_CONN_LIFETIME=30m
JBM_DB_MAX_CONN_IDLE_TIME=5m
JBM_DB_HEALTH_TIMEOUT=2s

JBM_LOG_LEVEL=info

# Online session (opaque cookie) — docs/API_CONTRACT.md §4
JBM_SESSION_TTL=720h
# Must be true in staging/production; only relax for HTTPS-less local dev.
JBM_SESSION_COOKIE_SECURE=true

# Password hashing (Argon2id) — tune to your deployment hardware
JBM_ARGON2_MEMORY_KIB=65536
JBM_ARGON2_ITERATIONS=3
JBM_ARGON2_PARALLELISM=2

# Offline authorization lease (Ed25519) — docs/ARCHITECTURE.md §11.2
# Required in production. Generate a pair with crypto/ed25519.GenerateKey
# and base64.StdEncoding-encode both keys. Left blank outside production, an
# ephemeral development-only keypair is generated at startup instead
# (invalidating any previously issued lease on every restart).
JBM_OFFLINE_LEASE_TTL=168h
JBM_OFFLINE_SIGNING_PRIVATE_KEY=
JBM_OFFLINE_SIGNING_PUBLIC_KEY=

# Canonical application URL; must be https:// in production
JBM_PUBLIC_BASE_URL=

# Transactional email (internal/email) for signup OTP delivery. Required in
# production. Gmail: use an app password (myaccount.google.com/apppasswords),
# not the account password -- Gmail rejects the account password over SMTP.
# Left blank outside production, signup codes are only logged, not emailed.
JBM_SMTP_HOST=smtp.gmail.com
JBM_SMTP_PORT=587
JBM_SMTP_USERNAME=
JBM_SMTP_PASSWORD=
JBM_SMTP_FROM=

# A failed send is retried this many times total (the original attempt plus
# retries), with exponential backoff starting at the base delay below.
# Applies only to the real SMTP provider -- the console dev fallback never
# fails, so there is nothing to retry outside production.
JBM_SMTP_MAX_SEND_ATTEMPTS=3
JBM_SMTP_RETRY_BASE_DELAY=500ms

# How long a signup verification code stays valid.
JBM_SIGNUP_OTP_TTL=10m

# Optional: "Sign in with Google" (internal/oauth). Leave unset to disable
# it entirely -- POST /auth/google is simply not registered, unlike SMTP
# there is no dev fallback and no production requirement for this. Create
# an OAuth 2.0 Client ID of type "Web application" in Google Cloud Console
# (console.cloud.google.com/apis/credentials); this is a public identifier,
# not a secret -- the frontend needs the same value as
# VITE_GOOGLE_OAUTH_CLIENT_ID (web/.env). No client secret is needed: this
# backend only verifies ID tokens issued client-side, it never talks to
# Google's token endpoint itself.
JBM_GOOGLE_OAUTH_CLIENT_ID=
