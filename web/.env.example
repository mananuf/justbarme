# Must match the backend's JBM_OFFLINE_SIGNING_PUBLIC_KEY exactly (same
# base64-encoded Ed25519 public key) -- see docs/ARCHITECTURE.md §11.2. Used
# to verify a device's offline authorization lease locally, without a
# network round trip.
VITE_OFFLINE_SIGNING_PUBLIC_KEY=

# Where the Vite dev server proxies /api requests -- must match the
# backend's own JBM_HTTP_ADDR (in the *root* .env, a separate file). Defaults
# to http://localhost:8080 if unset. Every request silently 502s if this
# drifts out of sync with the backend's actual port.
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional: enables the "Sign in with Google" button (GoogleSignInButton.tsx)
# on Login and SignUp. Must be the same OAuth 2.0 Client ID as the backend's
# JBM_GOOGLE_OAUTH_CLIENT_ID -- a public identifier, not a secret. Leave
# unset to omit the button entirely; the backend not having
# JBM_GOOGLE_OAUTH_CLIENT_ID set either is what actually disables the
# feature server-side, this only controls whether the frontend tries to
# render it.
VITE_GOOGLE_OAUTH_CLIENT_ID=
